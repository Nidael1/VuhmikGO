# VUHMÍK — Variables de entorno requeridas
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas .env al repositorio.

# ── Base de datos ──────────────────────────────────────────────────────────────
# PostgreSQL. Formato: postgres://usuario:contraseña@host:puerto/nombre_db?sslmode=disable
DATABASE_URL=postgres://vuhmik:contraseña@localhost:5432/vuhmik?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis para tokens JWT, workers y WAR-A.
REDIS_URL=redis://localhost:6379

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Secreto para firmar JWT. Mínimo 32 caracteres aleatorios.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# ── Almacenamiento ────────────────────────────────────────────────────────────
# Directorio donde el backend escribe backups automáticos (WAR-A).
BACKUP_DIR=/app/backups

# Directorio de logs estructurados JSON.
LOG_DIR=/app/logs
