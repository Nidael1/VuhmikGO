# VUHMÍK — Variables de entorno requeridas
# Copia este archivo como .env y llena los valores reales.
# NUNCA subas .env al repositorio.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  VALORES LISTOS — solo cambia la contraseña de PostgreSQL               │
# │  Nombre de BD: vuhmik  │  Usuario: vuhmik  │  Puerto Postgres: 5432     │
# │  Puerto Redis: 6379    │  Puerto API: 8080  │  Puerto Frontend: 5173     │
# └─────────────────────────────────────────────────────────────────────────┘

# ── Base de datos ──────────────────────────────────────────────────────────────
# Cambia SOLO "tu_password" por la contraseña que le pongas al usuario vuhmik en PostgreSQL.
DATABASE_URL=postgres://vuhmik:tu_password@localhost:5432/vuhmik?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
# Sin contraseña en dev local — no cambies nada.
REDIS_URL=redis://localhost:6379

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Secreto JWT fijo para dev — NO uses este en producción.
# Mac/Linux: openssl rand -hex 32
# Windows PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
JWT_SECRET=dev_secret_vuhmik_2026_cambia_en_produccion_x9f2k

# ── Almacenamiento ────────────────────────────────────────────────────────────
# Mac/Linux — usar estas rutas:
BACKUP_DIR=/tmp/vuhmik-backups
LOG_DIR=/tmp/vuhmik-logs

# Windows — comentar las de arriba y descomentar estas:
# BACKUP_DIR=C:\Users\%USERNAME%\vuhmik-backups
# LOG_DIR=C:\Users\%USERNAME%\vuhmik-logs
